# Photon 2.0 iMessage agent (app.photon.codes): project API key + project id
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Any random string; the Photon webhook URL is <PUBLIC_URL>/api/photon/webhook?token=<this>
PHOTON_WEBHOOK_TOKEN=
# The deployed site, used for the "hear the room" link in texts
PUBLIC_URL=

# Decrypts deploy/index.bin on a hosted deploy (scripts/pack_data.py)
DATA_KEY=
