# CoStar track keys (from /costar-keys in the track Discord)
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=

# Agent brain (pick one; leave all blank to use the built-in planner)
# Deep Agents with any LangChain model, e.g. anthropic:claude-opus-5-5 or openrouter:<free model id>
SCOUT_LLM=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Capital One Nessie (tour budget)
